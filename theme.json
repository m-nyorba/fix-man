{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "color": {
      "palette": [
        {
          "name": "Primary",
          "color": "#013791",
          "slug": "primary"
        },
        {
          "name": "Secondary",
          "color": "#D7601C",
          "slug": "secondary"
        },
        {
          "name": "Heading",
          "color": "#212529",
          "slug": "heading"
        },
        {
          "name": "Body",
          "color": "#525861",
          "slug": "body"
        },
        {
          "name": "Background",
          "color": "#FCFCFD",
          "slug": "background"
        },
        {
          "name": "Tertiary",
          "color": "#EAECEF",
          "slug": "tertiary"
        },
        {
          "name": "Quaternary",
          "color": "#F2F3F5",
          "slug": "quaternary"
        },
        {
          "name": "Surface",
          "color": "#BCD1E1",
          "slug": "surface"
        },
        {
          "name": "Foreground",
          "color": "#171869",
          "slug": "foreground"
        },
        {
          "name": "Outline",
          "color": "#CAD1D8",
          "slug": "outline"
        },
        {
          "name": "Neutral",
          "color": "#878E96",
          "slug": "neutral"
        },
        {
          "name": "Dark Blue",
          "color": "#0F1053",
          "slug": "dark-blue"
        },
        {
          "name": "Blue",
          "color": "#86ACCA",
          "slug": "blue"
        },
        {
          "name": "Yellow",
          "color": "#E9B32A",
          "slug": "yellow"
        },
        {
          "name": "Muted",
          "color": "#B6BABF",
          "slug": "muted"
        },
        {
          "name": "Info",
          "color": "#005BBB",
          "slug": "info"
        },
        {
          "name": "Success",
          "color": "#4caf50",
          "slug": "success"
        },
        {
          "name": "Warning",
          "color": "#ffaa00",
          "slug": "warning"
        },
        {
          "name": "Error",
          "color": "#f44336",
          "slug": "error"
        }
      ],
      "gradients": [
        {
          "slug": "primary",
          "gradient": "linear-gradient(180deg, var(--wp--preset--color--dark-blue) 0%, color-mix(in srgb, var(--wp--preset--color--neutral) 0%, transparent) 90%);",
          "name": "Primary"
        }
      ],
      "duotone": [
        {
          "colors": [
            "#013791",
            "#013791"
          ],
          "slug": "primary",
          "name": "Primary"
        },
        {
          "colors": [
            "#D7601C",
            "#D7601C"
          ],
          "slug": "secondary",
          "name": "Secondary"
        },
        {
          "colors": [
            "#FCFCFD",
            "#FCFCFD"
          ],
          "slug": "tertiary",
          "name": "Tertiary"
        }
      ]
    },
    "appearanceTools": true,
    "spacing": {
      "defaultSpacingSizes": false,
      "spacing": {
        "blockGap": true
      },
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ],
      "spacingScale": {
        "operator": "*",
        "increment": 0,
        "steps": 0,
        "mediumStep": 0,
        "unit": "px"
      },
      "spacingSizes": [
        {
          "name": "XXX Small",
          "slug": "xxx-small",
          "size": "0.25rem",
          "fluid": false
        },
        {
          "name": "XX Small",
          "slug": "xx-small",
          "size": "0.5rem",
          "fluid": false
        },
        {
          "name": "X Small Plus",
          "slug": "x-small-plus",
          "size": "0.625rem",
          "fluid": false
        },
        {
          "name": "X Small",
          "slug": "x-small",
          "size": "1rem",
          "fluid": {
            "min": "0.875rem",
            "max": "1rem"
          }
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "1.5rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.5rem"
          }
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "2rem",
          "fluid": {
            "min": "1.375rem",
            "max": "2rem"
          }
        },
        {
          "name": "Large",
          "size": "3rem",
          "slug": "large",
          "fluid": {
            "min": "1.75rem",
            "max": "3rem"
          }
        },
        {
          "name": "X Large",
          "slug": "x-large",
          "size": "3.5rem",
          "fluid": {
            "min": "2rem",
            "max": "3.5rem"
          }
        },
        {
          "name": "X Large Plus",
          "slug": "x-large-plus",
          "size": "4rem",
          "fluid": {
            "min": "2.25rem",
            "max": "4rem"
          }
        },
        {
          "name": "XX Large",
          "slug": "xx-large",
          "size": "6rem",
          "fluid": {
            "min": "2.75rem",
            "max": "6rem"
          }
        }
      ]
    },
    "typography": {
      "fluid": {
        "minViewportWidth": "320px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "src": [
                "file:./assets/fonts/manrope/Manrope-Variable.ttf"
              ]
            }
          ],
          "fontFamily": "\"Manrope\", \"Golos Text\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "name": "Manrope",
          "slug": "manrope"
        },
        {
          "fontFace": [
            {
              "fontFamily": "Golos Text",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/golos-text/GolosText-Variable.ttf"
              ]
            }
          ],
          "fontFamily": "\"Golos Text\", \"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "name": "Golos Text",
          "slug": "golos-text"
        }
      ],
      "fontSizes": [
        {
          "name": "X Small",
          "size": "0.9375rem",
          "slug": "x-small",
          "fluid": {
            "min": "0.8125rem",
            "max": "0.9375rem"
          }
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "small",
          "fluid": false
        },
        {
          "name": "Medium",
          "size": "1.25rem",
          "slug": "medium",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.25rem"
          }
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "name": "X Large",
          "size": "2rem",
          "slug": "x-large",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "name": "XX Large",
          "size": "2.5rem",
          "slug": "xx-large",
          "fluid": {
            "min": "1.75rem",
            "max": "2.5rem"
          }
        },
        {
          "name": "XXX Large",
          "size": "3rem",
          "slug": "xxx-large",
          "fluid": {
            "min": "2rem",
            "max": "3rem"
          }
        },
        {
          "name": "XXXX Large",
          "size": "4rem",
          "slug": "xxxx-large",
          "fluid": {
            "min": "2.5rem",
            "max": "3.5rem"
          }
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "shadow": {
      "presets": [
        {
          "name": "Shadow 1",
          "slug": "sh-1",
          "shadow": "0 4px 8px color-mix(in srgb, var(--wp--preset--color--heading) 10%, transparent)"
        },
        {
          "name": "Shadow 2",
          "slug": "sh-2",
          "shadow": "0 4px 20px color-mix(in srgb, var(--wp--preset--color--heading) 15%, transparent)"
        },
        {
          "name": "Shadow 3",
          "slug": "sh-3",
          "shadow": "0 10px 32px color-mix(in srgb, var(--wp--preset--color--heading) 12%, transparent)"
        },
        {
          "name": "Shadow Up",
          "slug": "sh-up",
          "shadow": "0 -2px 12px color-mix(in srgb, var(--wp--preset--color--heading) 10%, transparent)"
        },
        {
          "name": "Ring",
          "slug": "ring",
          "shadow": "0 0 0 2px color-mix(in srgb, var(--wp--preset--color--primary) 28%, transparent)"
        }
      ]
    },
    "custom": {
      "borderRadius": {
        "xxSmall": "4px",
        "xSmall": "6px",
        "small": "8px",
        "medium": "12px",
        "large": "16px",
        "xLarge": "20px",
        "xxLarge": "24px",
        "extraLarge": "32px",
        "xExtraLarge": "40px",
        "full": "999px"
      },
      "transition": {
        "fast": ".12s ease",
        "normal": ".18s ease",
        "slow": ".24s ease",
        "slower": ".35s cubic-bezier(.4,0,.2,1)"
      },
      "font-family": {
        "body": "var:preset|font-family|manrope",
        "heading": "var:preset|font-family|manrope"
      },
      "fontWeight": {
        "black": 900,
        "extraBold": 800,
        "bold": 700,
        "semiBold": 600,
        "medium": 500,
        "regular": 400,
        "light": 300,
        "extraLight": 200,
        "thin": 100
      },
      "lineHeight": {
        "initial": 1,
        "xxSmall": 1.2,
        "xSmall": 1.3,
        "small": 1.4,
        "medium": 1.45,
        "large": 1.6
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|body"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|small",
      "padding": {
        "left": "var:preset|spacing|small",
        "right": "var:preset|spacing|small"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|small",
      "fontFamily": "var:custom|font-family|body",
      "fontWeight": "var:custom|font-weight|regular",
      "lineHeight": "var:custom|line-height|large"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|heading"
        }
      },
      "button": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "var:custom|font-weight|regular",
          "lineHeight": "var:custom|line-height|small"
        },
        "color": {
          "background": "var:preset|color|secondary",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--full)",
          "color": "var:preset|color|secondary"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|xxx-large",
          "fontWeight": "var:custom|font-weight|medium",
          "lineHeight": "var:custom|line-height|xx-small"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "var:custom|font-weight|medium",
          "lineHeight": "var:custom|line-height|xx-small"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "var:custom|font-weight|medium",
          "lineHeight": "var:custom|line-height|x-small"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "var:custom|font-weight|medium",
          "lineHeight": "var:custom|line-height|x-small"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|medium"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:custom|font-family|heading",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|medium",
          "letterSpacing": "0.05em"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--large)",
          "letterSpacing": "0"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--heading)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--heading)"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "var(--wp--custom--font-weight--regular)",
          "lineHeight": "var(--wp--custom--line-height--large)",
          "letterSpacing": "0.25px"
        },
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--small)"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      },
      "core/post-author": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "var(--wp--custom--line-height--initial)",
          "fontWeight": "var(--wp--custom--font-weight--regular)"
        },
        "color": {
          "text": "var(--wp--preset--color--body)"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--outline)"
        }
      },
      "core/post-content": {
        "spacing": {
          "padding": {
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--small)",
          "padding": {
            "left": "0",
            "right": "0"
          }
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "template-page-sidebar",
      "title": "Page sidebar",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-single-sidebar",
      "title": "Single sidebar",
      "postTypes": [
        "post"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header (Default RU)",
      "area": "header"
    },
    {
      "name": "header-uk",
      "title": "Header (UA)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (Default RU)",
      "area": "footer"
    },
    {
      "name": "footer-uk",
      "title": "Footer (UK)",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "sidebar"
    },
    {
      "area": "general",
      "name": "general",
      "title": "General"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "uncategorized"
    }
  ]
}